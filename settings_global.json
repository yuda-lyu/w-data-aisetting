{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "Bash",
      "WebSearch",
      "WebFetch",
      "Monitor",
      "Workflow",
      "Skill(deep-research)",
      "Skill(loop)",
      "PowerShell"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "autoUpdatesChannel": "latest",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "idleCompaction": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/transcript-size-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/transcript-size-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
