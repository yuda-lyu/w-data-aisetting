# Registry for the skills root (~/.claude/skills): own packages (wsemi, w-*) are published to this
# intranet Verdaccio, which also proxies npmjs for third-party packages. Anonymous read, no token.
# Applies to sync.bat and to any npm command run inside the skills root, whatever this machine's
# own npm settings are. Only the registry line is allowed here (checked by tools/check-skills.mjs).
registry=http://100.120.70.67:4873/
